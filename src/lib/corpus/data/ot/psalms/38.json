{"id":"psalms-38","name":"Psalms","chapter":38,"verses":[{"ref":"Psalms 38:1","englishText":"    Yahweh, don’t rebuke me in your wrath, neither chasten me in your hot displeasure. ","tokens":[{"id":"psalms-38-1-0","surface":"מִזְמ֖וֹר","lemma":"מִזְמוֹר","translit":"mizemvor","morph":"Noun common masculine singular absolute","glosses":[],"strongs":"H4210"},{"id":"psalms-38-1-1","surface":"לְדָוִ֣ד","lemma":"דָּוִד","translit":"ledavid","morph":"Preposition + Noun proper","glosses":[],"strongs":"H1732"},{"id":"psalms-38-1-2","surface":"לְהַזְכִּֽיר","lemma":"זָכַר","translit":"lehazekiyr","morph":"Preposition + Verb Hiphil Infinitive Construct","glosses":[],"strongs":"H2142"}],"language":"hebrew"},{"ref":"Psalms 38:2","englishText":"For your arrows have pierced me, your hand presses hard on me. ","tokens":[{"id":"psalms-38-2-0","surface":"יְֽהוָ֗ה","lemma":"יְהֹוָה","translit":"yehvah","morph":"Noun proper","glosses":[],"strongs":"H3068"},{"id":"psalms-38-2-1","surface":"אַל","lemma":"אַל","translit":"'al","morph":"Particle","glosses":[],"strongs":"H408"},{"id":"psalms-38-2-2","surface":"בְּקֶצְפְּךָ֥","lemma":"קֶצֶף","translit":"beqetsepeka","morph":"Preposition + Noun common masculine singular construct + Suffix plural 2nd masculine singular","glosses":[],"strongs":"H7110"},{"id":"psalms-38-2-3","surface":"תוֹכִיחֵ֑נִי","lemma":"יָכַח","translit":"tvokiycheniy","morph":"Verb Hiphil Imperative 2nd masculine singular + Suffix plural 1st common singular","glosses":[],"strongs":"H3198"},{"id":"psalms-38-2-4","surface":"וּֽבַחֲמָתְךָ֥","lemma":"חֵמָה","translit":"vbachmateka","morph":"Conjunction + Preposition + Noun common feminine singular construct + Suffix plural 2nd masculine singular","glosses":[],"strongs":"H2534"},{"id":"psalms-38-2-5","surface":"תְיַסְּרֵֽנִי","lemma":"יָסַר","translit":"teyasereniy","morph":"Verb Piel Imperative 2nd masculine singular + Suffix plural 1st common singular","glosses":[],"strongs":"H3256"}],"language":"hebrew"},{"ref":"Psalms 38:3