{"id":"psalms-70","name":"Psalms","chapter":70,"verses":[{"ref":"Psalms 70:1","englishText":"    Hurry, God, to deliver me. Come quickly to help me, Yahweh. ","tokens":[{"id":"psalms-70-1-0","surface":"לַ֝מְנַצֵּ֗חַ","lemma":"נָצַח","translit":"lamenatsecha","morph":"Preposition dual + Verb Piel Passive Participle","glosses":[],"strongs":"H5329"},{"id":"psalms-70-1-1","surface":"לְדָוִ֥ד","lemma":"דָּוִד","translit":"ledavid","morph":"Preposition + Noun proper","glosses":[],"strongs":"H1732"},{"id":"psalms-70-1-2","surface":"לְהַזְכִּֽיר","lemma":"זָכַר","translit":"lehazekiyr","morph":"Preposition + Verb Hiphil Infinitive Construct","glosses":[],"strongs":"H2142"}],"language":"hebrew"},{"ref":"Psalms 70:2","englishText":"Let them be disappointed and confounded who seek my soul. Let those who desire my ruin be turned back in disgrace. ","tokens":[{"id":"psalms-70-2-0","surface":"אֱלֹהִ֥ים","lemma":"אֱלֹהִים","translit":"'lohiym","morph":"Noun common masculine plural absolute","glosses":[],"strongs":"H430"},{"id":"psalms-70-2-1","surface":"לְהַצִּילֵ֑נִי","lemma":"נָצַל","translit":"lehatsiyleniy","morph":"Preposition + Verb Hiphil Infinitive Construct + Suffix plural 1st common singular","glosses":[],"strongs":"H5337"},{"id":"psalms-70-2-2","surface":"יְ֝הוָ֗ה","lemma":"יְהֹוָה","translit":"yehvah","morph":"Noun proper","glosses":[],"strongs":"H3068"},{"id":"psalms-70-2-3","surface":"לְעֶזְרָ֥תִי","lemma":"עֶזְרָה","translit":"le`ezeratiy","morph":"Preposition + Noun common feminine singular construct + Suffix plural 1st common singular","glosses":[],"strongs":"H5833"},{"id":"psalms-70-2-4","surface":"חֽוּשָֽׁה","lemma":"חוּשׁ","translit":"chvshah","morph":"Verb Qal Weqatal 2nd masculine singular + Suffix","glosses":[],"strongs":"H2363"}],"language":"hebrew"},{"ref":"Psalms 70:3","englishText":"Let them be turned because of their shame Who say, “Aha! Aha!” ","tokens":[{"id":"psalms-70-3-0","surface":"יֵבֹ֣שׁוּ","lemma":"בּוּשׁ","translit":"yeboshv","morph":"Verb Qal