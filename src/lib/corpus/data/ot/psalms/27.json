82"},{"id":"psalms-27-2-11","surface":"וְנָפָֽלוּ","lemma":"נָפַל","translit":"venapalv","morph":"Conjunction + Verb Qal Participle 3rd common plural","glosses":[],"strongs":"H5307"}],"language":"hebrew"},{"ref":"Psalms 27:3","englishText":"Though an army should encamp against me, my heart shall not fear. Though war should rise against me, even then I will be confident. ","tokens":[{"id":"psalms-27-3-0","surface":"אִם","lemma":"אִם","translit":"'im","morph":"Conjunction","glosses":[],"strongs":"H518"},{"id":"psalms-27-3-1","surface":"תַּחֲנֶ֬ה","lemma":"חָנָה","translit":"tachneh","morph":"Verb Qal Imperative 3rd feminine singular","glosses":[],"strongs":"H2583"},{"id":"psalms-27-3-2","surface":"עָלַ֨י","lemma":"עַל","translit":"`alay","morph":"Preposition + Suffix plural 1st common singular","glosses":[],"strongs":"H5921"},{"id":"psalms-27-3-3","surface":"מַחֲנֶה֮","lemma":"מַחֲנֶה","translit":"machneh","morph":"Noun common singular absolute","glosses":[],"strongs":"H4264"},{"id":"psalms-27-3-4","surface":"לֹֽא","lemma":"לֹא","translit":"lo'","morph":"Particle","glosses":[],"strongs":"H3808"},{"id":"psalms-27-3-5","surface":"יִירָ֪א","lemma":"יָרֵא","translit":"yiyra'","morph":"Verb Qal Imperative 3rd masculine singular","glosses":[],"strongs":"H3372"},{"id":"psalms-27-3-6","surface":"לִ֫בִּ֥י","lemma":"לֵב","translit":"libiy","morph":"Noun common masculine singular construct + Suffix plural 1st common singular","glosses":[],"strongs":"H3820"},{"id":"psalms-27-3-7","surface":"אִם","lemma":"אִם","translit":"'im","morph":"Conjunction","glosses":[],"strongs":"H518"},{"id":"psalms-27-3-8","surface":"תָּק֣וּם","lemma":"קוּם","translit":"taqvm","morph":"Verb Qal Imperative 3rd feminine singular","glosses":[],"strongs":"H6965"},{"id":"psalms-27-3-9","surface":"עָ֭לַי","lemma":"עַל","translit":"`alay","morph":"Preposition + Suffix plural 1st common singular","glosses":[],"strongs":"H5921"},{"id":"psalms-27-3-10","surface":"מִלְחָמָ֑ה","lemma":"מִלְחָמָה","translit":"milech