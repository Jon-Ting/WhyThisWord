{"id":"psalms-27","name":"Psalms","chapter":27,"verses":[{"ref":"Psalms 27:1","englishText":"    Yahweh is my light and my salvation. Whom shall I fear? Yahweh is the strength of my life. Of whom shall I be afraid? ","tokens":[{"id":"psalms-27-1-0","surface":"לְדָוִ֨ד","lemma":"דָּוִד","translit":"ledavid","morph":"Preposition + Noun proper","glosses":[],"strongs":"H1732"},{"id":"psalms-27-1-1","surface":"יְהוָ֤ה","lemma":"יְהֹוָה","translit":"yehvah","morph":"Noun proper","glosses":[],"strongs":"H3068"},{"id":"psalms-27-1-2","surface":"אוֹרִ֣י","lemma":"אוֹר","translit":"'voriy","morph":"Noun common singular construct + Suffix plural 1st common singular","glosses":[],"strongs":"H216"},{"id":"psalms-27-1-3","surface":"וְ֭יִשְׁעִי","lemma":"יֶשַׁע","translit":"veyishe`iy","morph":"Conjunction + Noun common masculine singular construct + Suffix plural 1st common singular","glosses":[],"strongs":"H3468"},{"id":"psalms-27-1-4","surface":"מִמִּ֣י","lemma":"מִי","translit":"mimiy","morph":"Preposition + Particle","glosses":[],"strongs":"H4310"},{"id":"psalms-27-1-5","surface":"אִירָ֑א","lemma":"יָרֵא","translit":"'iyra'","morph":"Verb Qal Imperative 1st common singular","glosses":[],"strongs":"H3372"},{"id":"psalms-27-1-6","surface":"יְהוָ֥ה","lemma":"יְהֹוָה","translit":"yehvah","morph":"Noun proper","glosses":[],"strongs":"H3068"},{"id":"psalms-27-1-7","surface":"מָֽעוֹז","lemma":"מָעוֹז","translit":"ma`voz","morph":"Noun common masculine singular construct","glosses":[],"strongs":"H4581"},{"id":"psalms-27-1-8","surface":"חַ֝יַּ֗י","lemma":"חַי","translit":"chayay","morph":"Noun common masculine plural construct + Suffix plural 1st common singular","glosses":[],"strongs":"H2416"},{"id":"psalms-27-1-9","surface":"מִמִּ֥י","lemma":"מִי","translit":"mimiy","morph":"Preposition + Particle","glosses":[],"strongs":"H4310"},{"id":"psalms-27-1-10","surface":"אֶפְחָֽד","lemma":"פָּחַד","translit":"'epechad","morph":"Verb Qal Imperative 1st common singular","glosses":[],"strongs"