ine singular absolute","glosses":[],"strongs":"H120"},{"id":"psalms-53-3-6","surface":"לִ֭רְאוֹת","lemma":"רָאָה","translit":"lire'vot","morph":"Preposition + Verb Qal Infinitive Construct","glosses":[],"strongs":"H7200"},{"id":"psalms-53-3-7","surface":"הֲיֵ֣שׁ","lemma":"יֵשׁ","translit":"hyesh","morph":"Particle + Particle masculine","glosses":[],"strongs":"H3426"},{"id":"psalms-53-3-8","surface":"מַשְׂכִּ֑יל","lemma":"שָׂכַל","translit":"mashekiyl","morph":"Verb Hiphil Passive Participle","glosses":[],"strongs":"H7919"},{"id":"psalms-53-3-9","surface":"דֹּ֝רֵ֗שׁ","lemma":"דָּרַשׁ","translit":"doresh","morph":"Verb Qal Passive Participle","glosses":[],"strongs":"H1875"},{"id":"psalms-53-3-10","surface":"אֶת","lemma":"אֵת","translit":"'et","morph":"Particle","glosses":[],"strongs":"H853"},{"id":"psalms-53-3-11","surface":"אֱלֹהִֽים","lemma":"אֱלֹהִים","translit":"'lohiym","morph":"Noun common masculine plural absolute","glosses":[],"strongs":"H430"}],"language":"hebrew"},{"ref":"Psalms 53:4","englishText":"Have the workers of iniquity no knowledge, who eat up my people as they eat bread, and don’t call on God? ","tokens":[{"id":"psalms-53-4-0","surface":"כֻּלּ֥וֹ","lemma":"כֹּל","translit":"kulvo","morph":"Noun common masculine singular construct + Suffix plural 3rd masculine singular","glosses":[],"strongs":"H3605"},{"id":"psalms-53-4-1","surface":"סָג֮","lemma":"סוּג","translit":"sag","morph":"Verb Qal Participle 3rd masculine singular","glosses":[],"strongs":"H5472"},{"id":"psalms-53-4-2","surface":"יַחְדָּ֪ו","lemma":"יַחַד","translit":"yachedav","morph":"Adverb","glosses":[],"strongs":"H3162"},{"id":"psalms-53-4-3","surface":"נֶ֫אֱלָ֥חוּ","lemma":"אָלַח","translit":"ne'lachv","morph":"Verb Niphal Participle 3rd common plural","glosses":[],"strongs":"H444"},{"id":"psalms-53-4-4","surface":"אֵ֤ין","lemma":"אַיִן","translit":"'eyn","morph":"Particle","glosses":[],"strongs":"H369"},{"id":"psalms-53-4-5","surface":"עֹֽשֵׂה","lemma":"עָשָׂה","translit":"`osheh","mor